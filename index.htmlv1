// --- Replace the existing index.html section with the following enhanced dashboard version ---

// (NOTE: Copy this entire HTML and replace the current index.html in /public/)

// DASHBOARD HTML STARTS HERE

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Birthday Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Poppins',sans-serif;background:linear-gradient(180deg,#f6f8fb,#e9eef8);margin:0;padding:20px}
    .container{max-width:950px;margin:0 auto}
    header{display:flex;align-items:center;gap:12px}
    h1{font-size:1.8rem;margin:0}
    .card{background:#fff;border-radius:12px;padding:18px;box-shadow:0 6px 20px rgba(20,30,60,0.08);margin-top:18px}
    .section-title{font-size:1.2rem;font-weight:600;margin-bottom:10px}
    .muted{color:#6b7280;font-size:0.95rem}
    .highlight{background:#fff4d2}
    input,button{padding:10px;border-radius:8px;border:1px solid #e6eef8;font-size:0.95rem}
    button{cursor:pointer;background:linear-gradient(90deg,#667eea,#764ba2);color:#fff;border:none}
    table{width:100%;border-collapse:collapse;margin-top:12px}
    th,td{padding:10px;border-bottom:1px solid #f1f5f9;text-align:left}
    .pill{display:inline-block;padding:6px 10px;background:#eaf2ff;border-radius:20px;font-size:0.85rem;margin-right:8px}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div style="font-size:2.2rem">🎂</div>
      <div>
        <h1>Birthday Dashboard</h1>
        <div class="muted">Today's birthdays, upcoming birthdays, and full list — same clean design</div>
      </div>
    </header>

    <!-- Add Birthday Form -->
    <div class="card">
      <div class="section-title">Add Birthday</div>
      <form id="addForm">
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <input type="text" id="name" placeholder="Full name" style="flex:2">
          <input type="date" id="date" style="flex:1">
          <input type="tel" id="phone" placeholder="Phone" style="flex:1">
        </div>
        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
          <input type="email" id="email" placeholder="Email">
          <input type="text" id="notes" placeholder="Notes (optional)">
          <button type="submit">Save</button>
        </div>
      </form>
    </div>

    <!-- TODAY'S BIRTHDAYS -->
    <div class="card">
      <div class="section-title">🎉 Today's Birthdays</div>
      <div id="todayList" class="muted">Checking…</div>
    </div>

    <!-- UPCOMING BIRTHDAYS -->
    <div class="card">
      <div class="section-title">📅 Upcoming (Next 30 Days)</div>
      <div id="upcomingList" class="muted">Loading…</div>
    </div>

    <!-- FULL LIST -->
    <div class="card">
      <div class="section-title">📘 All Birthdays</div>
      <input id="search" placeholder="Search name…" style="width:100%;margin-bottom:12px">
      <table id="allTable" style="display:none">
        <thead><tr><th>#</th><th>Name</th><th>Date</th><th>Phone</th><th>Email</th><th>Notes</th><th></th></tr></thead>
        <tbody id="allTbody"></tbody>
      </table>
      <div id="allEmpty" class="muted">Loading…</div>
    </div>
  </div>

<script>
function formatMMDD(dateStr){
  if(dateStr.includes('-')){
    let p=dateStr.split('-');
    if(p.length===3) return p[1]+'-'+p[2];
    if(p.length===2) return p[0]+'-'+p[1];
  }
  if(dateStr.includes('/')){
    let p=dateStr.split('/');
    return p[0]+'-'+p[1];
  }
  return null;
}

function mmddToDate(mmdd){
  let [m,d]=mmdd.split('-');
  return new Date(new Date().getFullYear(),m-1,d);
}

function diffDays(date){
  let now=new Date();
  now.setHours(0,0,0,0);
  let d=new Date(date);
  d.setHours(0,0,0,0);
  return (d-now)/(1000*3600*24);
}

async function load(){
  const res=await fetch('/api/birthdays');
  const data=await res.json();

  // sort by date order (month/day)
  data.sort((a,b)=>{
    let da=formatMMDD(a.date), db=formatMMDD(b.date);
    return da.localeCompare(db);
  });

  const today=new Date();
  const mm=String(today.getMonth()+1).padStart(2,'0');
  const dd=String(today.getDate()).padStart(2,'0');
  const todayMMDD=mm+'-'+dd;

  // Today
  let tlist=data.filter(b=>formatMMDD(b.date)===todayMMDD);
  const tdiv=document.getElementById('todayList');
  if(!tlist.length) tdiv.textContent='No birthdays today'; else tdiv.innerHTML=tlist.map(t=>`<div class='pill'>${t.name}</div>`).join('');

  // Upcoming (next 30 days)
  let upcoming=data.filter(b=>{
    let mmdd=formatMMDD(b.date);
    let dt=mmddToDate(mmdd);
    let d=diffDays(dt);
    return d>0 && d<=30;
  });
  const up=document.getElementById('upcomingList');
  if(!upcoming.length) up.textContent='No upcoming birthdays'; else up.innerHTML=upcoming.map(u=>`<div class='pill'>${u.name} • ${u.date}</div>`).join('');

  // Full list
  const tbody=document.getElementById('allTbody');
  tbody.innerHTML='';
  data.forEach((b,i)=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`<td>${i+1}</td><td>${b.name}</td><td>${b.date}</td><td>${b.phone||'-'}</td><td>${b.email||'-'}</td><td>${b.notes||'-'}</td>
      <td><button data-id='${b.id}' class='del'>Delete</button></td>`;
    tbody.appendChild(tr);
  });

  if(data.length){
    document.getElementById('allEmpty').style.display='none';
    document.getElementById('allTable').style.display='';
  }

  // Delete function
  document.querySelectorAll('.del').forEach(btn=>{
    btn.onclick=async()=>{
      await fetch('/api/birthdays/'+btn.dataset.id,{method:'DELETE'});
      load();
    }
  });

  // Search
  document.getElementById('search').oninput=e=>{
    let v=e.target.value.toLowerCase();
    [...tbody.children].forEach(row=>{
      row.style.display=row.children[1].textContent.toLowerCase().includes(v)?'':'none';
    });
  };
}

// Add form
const form=document.getElementById('addForm');
form.onsubmit=async(e)=>{
  e.preventDefault();
  const name=document.getElementById('name').value.trim();
  const date=document.getElementById('date').value;
  const phone=document.getElementById('phone').value;
  const email=document.getElementById('email').value;
  const notes=document.getElementById('notes').value;
  if(!name||!date) return alert('Name + date required');
  await fetch('/api/birthdays',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,date,phone,email,notes})});
  form.reset();
  load();
};

load();
</script>
</body>
</html>
// DASHBOARD HTML ENDS HERE
