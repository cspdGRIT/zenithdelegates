// ==============================
// Birthday Notifier – Full Stack
// Frontend (React) + Backend (Node.js + Express + Cron + Nodemailer)
// ==============================
// This single file shows the complete structure for your website.
// Split into files when implementing.

/* ==============================
   BACKEND: server.js
   ============================== */

// Install dependencies:
// npm install express nodemailer node-cron cors body-parser

const express = require('express');
const bodyParser = require('body-parser');
const cors = require('cors');
const cron = require('node-cron');
const nodemailer = require('nodemailer');
const fs = require('fs');

const app = express();
app.use(cors());
app.use(bodyParser.json());

// Store birthdays locally in JSON file
const DATA_FILE = './birthdays.json';
if (!fs.existsSync(DATA_FILE)) fs.writeFileSync(DATA_FILE, JSON.stringify([]));

// Email transporter (use Gmail)
let transporter = nodemailer.createTransport({
  service: 'gmail',
  auth: {
    user: 'pdcind369@gmail.com', // sender
    pass: 'YOUR_APP_PASSWORD',  // Gmail app password
  },
});

// API: Add birthday
app.post('/add-birthday', (req, res) => {
  const { name, date } = req.body;
  const birthdays = JSON.parse(fs.readFileSync(DATA_FILE));
  birthdays.push({ name, date });
  fs.writeFileSync(DATA_FILE, JSON.stringify(birthdays, null, 2));
  res.json({ success: true });
});

// Daily cron at 11:59 PM → send at midnight
cron.schedule('59 23 * * *', () => {
  const today = new Date();
  const tomorrow = new Date(today.getTime() + 24 * 60 * 60 * 1000);
  const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
  const day = String(tomorrow.getDate()).padStart(2, '0');
  const mmdd = `${month}-${day}`;

  const birthdays = JSON.parse(fs.readFileSync(DATA_FILE));

  birthdays.forEach((b) => {
    if (b.date.endsWith(mmdd)) {
      transporter.sendMail({
        to: 'pdcind369@gmail.com',
        subject: `Birthday Reminder: ${b.name}`,
        text: `Reminder: It's ${b.name}'s birthday tomorrow!`,
      });
    }
  });
});

app.listen(4000, () => console.log('Server running on port 4000'));


/* ==============================
   FRONTEND: Simple React App (App.js)
   ============================== */

// Use: npx create-react-app birthday-app
// Replace src/App.js content with below

import React, { useState } from 'react';
import axios from 'axios';

export default function App() {
  const [name, setName] = useState('');
  const [date, setDate] = useState('');

  const addBirthday = async () => {
    await axios.post('http://localhost:4000/add-birthday', { name, date });
    alert('Birthday saved! Email notification will be sent every year.');
  };

  return (
    <div className="p-6 max-w-md mx-auto bg-white shadow rounded-xl mt-10">
      <h1 className="text-2xl font-bold mb-4">Birthday Notifier</h1>

      <input
        type="text"
        placeholder="Name"
        className="border p-2 w-full mb-3"
        value={name}
        onChange={(e) => setName(e.target.value)}
      />

      <input
        type="date"
        className="border p-2 w-full mb-3"
        value={date}
        onChange={(e) => setDate(e.target.value)}
      />

      <button
        onClick={addBirthday}
        className="bg-blue-600 text-white px-4 py-2 rounded"
      >
        Save Birthday
      </button>
    </div>
  );
}


/* ==============================
   birthdays.json (auto-created)
   ============================== */
[]


/* ==============================
   HOW IT WORKS
   ============================== */
// ✔ You visit website → enter Name + DOB
// ✔ Backend stores it in birthdays.json
// ✔ Cron job checks daily at 11:59 PM
// ✔ If tomorrow is someone's birthday → email goes to pdcind369@gmail.com
// ✔ Automatic yearly midnight reminders


